# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FinPilot AI

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/finpilot
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication (NextAuth)
AUTH_SECRET=your-auth-secret-generate-with-openssl-rand-base64-32
NEXT_PUBLIC_AUTH_URL=http://localhost:3000

# Email (for verification, password reset, notifications)
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email-user
EMAIL_SERVER_PASSWORD=your-email-password
EMAIL_FROM=noreply@yourdomain.com

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# AI / LLM
OPENAI_API_KEY=your-openai-api-key
# Optional: Alternative providers
# ANTHROPIC_API_KEY=your-anthropic-key
# GROQ_API_KEY=your-groq-key

# AI Model Configuration
AI_MODEL_CHAT=gpt-4o-mini
AI_MODEL_VISION=gpt-4o
AI_MODEL_EMBEDDING=text-embedding-3-small

# File Storage (Supabase Storage)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=documents

# Background Jobs (optional - for production)
# REDIS_URL=redis://localhost:6379
# QSTASH_URL=https://qstash.upstash.io
# QSTASH_TOKEN=your-qstash-token

# Feature Flags
ENABLE_AI_CATEGORIZATION=true
ENABLE_AI_INSIGHTS=true
ENABLE_AI_COPILOT=true
ENABLE_DOCUMENT_OCR=true
ENABLE_EMAIL_NOTIFICATIONS=false

# Indian Localization Defaults
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_DEFAULT_FINANCIAL_YEAR_START=04-01